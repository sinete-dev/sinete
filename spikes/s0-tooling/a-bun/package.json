{
  "name": "sinete-s0-bun",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '@sinete/*' build",
    "typecheck": "tsc -b --noEmit || tsc -p packages/core && tsc -p packages/xml && tsc -p packages/cli"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "3.0.3",
    "@types/node": "^22",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  }
}
