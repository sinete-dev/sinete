{
  "name": "@sinete/sefaz-sim",
  "version": "0.4.0",
  "description": "SEFAZ simulada com estado para testes: web services da NF-e 4.00 com as regras de validação do MOC, relógio injetado, cenários de falha e servidor HTTPS com mTLS",
  "keywords": [
    "nfe",
    "sefaz",
    "simulador",
    "teste",
    "soap",
    "brasil"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "exports": {
    ".": {
      "node": {
        "types": "./dist/index.node.d.ts",
        "default": "./dist/index.node.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinete-dev/sinete.git",
    "directory": "packages/sefaz-sim"
  },
  "homepage": "https://github.com/sinete-dev/sinete/tree/main/packages/sefaz-sim#readme",
  "bugs": "https://github.com/sinete-dev/sinete/issues",
  "scripts": {
    "build": "bun ../../scripts/build.ts ."
  },
  "dependencies": {
    "@sinete/cert": "workspace:^",
    "@sinete/core": "workspace:^",
    "@sinete/rejeicoes": "workspace:^",
    "@sinete/schemas": "workspace:^",
    "@sinete/transport": "workspace:^",
    "@sinete/validators": "workspace:^",
    "node-forge": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/node-forge": "1.3.14"
  },
  "publishConfig": {
    "access": "public"
  }
}
