{
  "name": "@sinete/mdfe",
  "version": "0.3.0",
  "description": "MDF-e modelo 58 (3.00b): modelo de entrada tipado do rodoviário, montagem com totais em decimal exato e regras de validação antes de assinar, QR Code, contingência off-line, autorização síncrona, consultas e eventos (cancelamento, encerramento, inclusão de condutor e de DF-e, pagamento da operação)",
  "keywords": [
    "mdfe",
    "dfe",
    "sefaz",
    "manifesto",
    "transporte",
    "brasil"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinete-dev/sinete.git",
    "directory": "packages/mdfe"
  },
  "homepage": "https://github.com/sinete-dev/sinete/tree/main/packages/mdfe#readme",
  "bugs": "https://github.com/sinete-dev/sinete/issues",
  "scripts": {
    "build": "bun ../../scripts/build.ts ."
  },
  "dependencies": {
    "@sinete/core": "workspace:^",
    "@sinete/rejeicoes": "workspace:^",
    "@sinete/schemas": "workspace:^",
    "@sinete/transport": "workspace:^",
    "@sinete/validators": "workspace:^"
  },
  "devDependencies": {
    "@sinete/sefaz-sim": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
