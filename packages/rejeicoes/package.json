{
  "name": "@sinete/rejeicoes",
  "version": "0.2.0",
  "description": "Catálogo versionado de rejeições e denegações da SEFAZ (NF-e e NFC-e, e o do MDF-e numa entrada própria) e dos códigos de erro da NFS-e Nacional, com mensagem oficial, origem da regra e diagnóstico",
  "keywords": [
    "nfe",
    "nfce",
    "sefaz",
    "rejeicao",
    "cstat",
    "brasil",
    "mdfe",
    "nfse"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mdfe": {
      "types": "./dist/mdfe.d.ts",
      "default": "./dist/mdfe.js"
    },
    "./nfse": {
      "types": "./dist/nfse.d.ts",
      "default": "./dist/nfse.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinete-dev/sinete.git",
    "directory": "packages/rejeicoes"
  },
  "homepage": "https://github.com/sinete-dev/sinete/tree/main/packages/rejeicoes#readme",
  "bugs": "https://github.com/sinete-dev/sinete/issues",
  "scripts": {
    "build": "bun ../../scripts/build.ts ."
  },
  "dependencies": {
    "@sinete/core": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
