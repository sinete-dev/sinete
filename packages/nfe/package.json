{
  "name": "@sinete/nfe",
  "version": "0.0.0",
  "description": "NF-e modelo 55: modelo de entrada tipado, montagem com totais em decimal exato, validação antes de assinar, autorização, consultas, eventos, inutilização, contingência SVC e Distribuição DF-e",
  "keywords": [
    "nfe",
    "dfe",
    "sefaz",
    "nota-fiscal",
    "ibs",
    "cbs",
    "brasil"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ibs-cbs": {
      "types": "./dist/ibs-cbs.d.ts",
      "default": "./dist/ibs-cbs.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinete-dev/sinete.git",
    "directory": "packages/nfe"
  },
  "homepage": "https://github.com/sinete-dev/sinete/tree/main/packages/nfe#readme",
  "bugs": "https://github.com/sinete-dev/sinete/issues",
  "scripts": {
    "build": "bun ../../scripts/build.ts ."
  },
  "dependencies": {
    "@sinete/core": "workspace:^",
    "@sinete/ibs-cbs": "workspace:^",
    "@sinete/ibs-cbs-dados": "workspace:^",
    "@sinete/rejeicoes": "workspace:^",
    "@sinete/schemas": "workspace:^",
    "@sinete/transport": "workspace:^",
    "@sinete/validators": "workspace:^"
  },
  "devDependencies": {
    "@sinete/sefaz-sim": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
